# =============================================
# BASE DE DATOS (PostgreSQL en Clever Cloud)
# =============================================
# Formato de Clever Cloud (copiar desde el panel del Add-on PostgreSQL):
# postgresql://<usuario>:<contraseña>@<host>-postgresql.services.clever-cloud.com:<puerto>/<nombre_bd>
DATABASE_URL="postgresql://usuario:contraseña@xxxxxxxx-postgresql.services.clever-cloud.com:5432/nombre_bd"

# =============================================
# JWT
# =============================================
JWT_SECRET="cambia-esto-por-un-secreto-muy-largo-y-seguro"
JWT_EXPIRES_IN="7d"

# =============================================
# CLOUDINARY (almacenamiento de imágenes y PDFs)
# =============================================
# Obtén las credenciales en: https://console.cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"

# =============================================
# STRIPE (pagos en modo test/sandbox)
# =============================================
# Obtén tus claves en: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Secret del webhook (https://dashboard.stripe.com/test/webhooks)
STRIPE_WEBHOOK_SECRET="whsec_..."

# =============================================
# ADMIN SEED (usuario administrador inicial)
# =============================================
ADMIN_EMAIL="admin@ceaamc.com"
ADMIN_PASSWORD="cambia-esta-contraseña"

# =============================================
# SERVIDOR
# =============================================
PORT=3001
NODE_ENV=development
# URL del frontend (CORS y redirecciones de Stripe Checkout)
FRONTEND_URL="http://localhost:5173"
