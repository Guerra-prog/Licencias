generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  student
}

enum EnrollmentStatus {
  pendiente
  pagado
  en_curso
  finalizado
}

enum PaymentStatus {
  pendiente
  aprobado
  rechazado
  reembolsado
}

model User {
  id                 String       @id @default(uuid())
  nombre             String
  email              String       @unique
  password           String
  telefono           String?
  documentoIdentidad String?      @unique @map("documento_identidad")
  role               Role         @default(student)
  activo             Boolean      @default(true)
  fechaRegistro      DateTime     @default(now()) @map("fecha_registro")
  fotoPerfilUrl      String?      @map("foto_perfil_url")
  resetToken         String?      @map("reset_token")
  resetTokenExpires  DateTime?    @map("reset_token_expires")
  enrollments        Enrollment[]

  @@map("users")
}

model License {
  id                    String       @id @default(uuid())
  codigo                String       @unique // A2, B1, C1, RC1, RC2
  nombre                String
  descripcion           String
  precioCurso           Int          @map("precio_curso")
  precioMedico          Int          @map("precio_medico")
  precioLicenciaTransito Int         @map("precio_licencia_transito")
  precioTotal           Int          @map("precio_total")
  horasTeoria           Int          @map("horas_teoria")
  horasTaller           Int          @map("horas_taller")
  horasPractica         Int          @map("horas_practica")
  horasTotal            Int          @map("horas_total")
  imagenUrl             String?      @map("imagen_url")
  requisitos            String?
  activo                Boolean      @default(true)
  combos                ComboLicense[]
  enrollments           Enrollment[]

  @@map("licenses")
}

model Combo {
  id            String         @id @default(uuid())
  nombre        String
  descripcion   String
  precioCurso   Int            @map("precio_curso")
  precioMedico  Int            @map("precio_medico")
  precioTransito Int           @map("precio_transito")
  precioTotal   Int            @map("precio_total")
  imagenUrl     String?        @map("imagen_url")
  activo        Boolean        @default(true)
  licenses      ComboLicense[]
  enrollments   Enrollment[]

  @@map("combos")
}

model ComboLicense {
  comboId   String  @map("combo_id")
  licenseId String  @map("license_id")
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@id([comboId, licenseId])
  @@map("combo_licenses")
}

model AdditionalService {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String
  activo      Boolean @default(true)

  @@map("additional_services")
}

model Enrollment {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")
  licenseId          String?          @map("license_id")
  comboId            String?          @map("combo_id")
  estado             EnrollmentStatus @default(pendiente)
  fechaInscripcion   DateTime         @default(now()) @map("fecha_inscripcion")
  licenciaEmitidaUrl String?          @map("licencia_emitida_url")
  codigoVerificacion String           @unique @map("codigo_verificacion")
  user               User             @relation(fields: [userId], references: [id])
  license            License?         @relation(fields: [licenseId], references: [id])
  combo              Combo?           @relation(fields: [comboId], references: [id])
  payments           Payment[]

  @@map("enrollments")
}

model Payment {
  id                    String        @id @default(uuid())
  enrollmentId          String        @map("enrollment_id")
  monto                 Int
  metodoPago            String        @map("metodo_pago")
  estado                PaymentStatus @default(pendiente)
  referenciaTransaccion String?       @map("referencia_transaccion")
  fecha                 DateTime      @default(now())
  enrollment            Enrollment    @relation(fields: [enrollmentId], references: [id])

  @@map("payments")
}
