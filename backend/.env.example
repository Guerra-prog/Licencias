# =============================================
# BASE DE DATOS
# =============================================
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/licencias_db"

# =============================================
# JWT
# =============================================
JWT_SECRET="cambia-esto-por-un-secreto-muy-largo-y-seguro"
JWT_EXPIRES_IN="7d"
JWT_RESET_EXPIRES_IN="1h"

# =============================================
# SERVIDOR
# =============================================
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# URL pública del servidor (usar ngrok en desarrollo para webhooks)
APP_URL="https://tu-ngrok-url.ngrok.io"

# =============================================
# STRIPE
# =============================================
# Obtén tus claves en: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Obtén el webhook secret al crear el webhook en: https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."

# =============================================
# EMAIL (SMTP)
# =============================================
# Para Gmail: usa una App Password (no tu contraseña normal)
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="tu-email@gmail.com"
SMTP_PASS="tu-app-password-de-16-chars"
EMAIL_FROM="Licencias Platform <noreply@tudominio.com>"

# =============================================
# TWILIO WHATSAPP
# =============================================
# Obtén tus credenciales en: https://console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Número del sandbox de WhatsApp de Twilio (o tu número aprobado)
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
